# Open Unifi configuration. Copy to `.env` next to docker-compose.yml.

# Public address of the site (used in notification links, RSS, Telegram).
OPENUNIFI_PUBLIC_URL=https://openunifi.it

# ── Admin panel (/admin) ─────────────────────────────────────
# Your email or a username of your choice. "admin", "root" and similar are
# refused: the user is a second secret, keep it out of public places.
OPENUNIFI_ADMIN_USER=CHANGE_ME
# Use 12+ characters. Plaintext works, but a hash is better. Generate one with:
#   docker compose run --rm --no-deps openunifi-app python -m app.cli hash-password
# (the hash contains no `$`, so it can be pasted as is)
# While this is empty or still CHANGE_ME the admin panel stays locked.
# Changing it logs out every open admin session.
OPENUNIFI_ADMIN_PASSWORD=CHANGE_ME

# Contact sent to the browsers' push services with every notification.
OPENUNIFI_VAPID_CONTACT=mailto:you@example.com

# ── Telegram (optional) ──────────────────────────────────────
# Create a bot with @BotFather and paste its token. Leave empty to disable.
OPENUNIFI_TELEGRAM_BOT_TOKEN=
# Optional public channel that receives every update, e.g. @openunifi_news
# (add the bot to the channel as an administrator first).
OPENUNIFI_TELEGRAM_CHANNEL=

# ── Advanced (defaults are fine) ─────────────────────────────
# Cookie-signing secret: generated and stored in the data volume when empty.
# OPENUNIFI_SECRET_KEY=
# Pause between requests to the university sites, in seconds.
# OPENUNIFI_REQUEST_DELAY_SECONDS=1.0
# Set to false to stop all checks (e.g. while debugging).
# OPENUNIFI_SCHEDULER_ENABLED=true
# Nightly database backup into ./backups: hour (Europe/Rome) and copies kept.
# OPENUNIFI_BACKUP_HOUR=4
# OPENUNIFI_BACKUP_KEEP=14
